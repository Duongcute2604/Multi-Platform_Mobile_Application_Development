{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["src/*"],
      "@shared/*": ["../packages/shared/src/*"],
      "@cookbook/shared/*": ["../packages/shared/src/*"],
      "@cookbook/shared": ["../packages/shared/src/index"],
      "@cook/shared/*": ["../packages/shared/src/*"],
      "@cook/shared": ["../packages/shared/src/index"]
    }
  }
}